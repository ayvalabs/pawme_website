
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
             (request.auth.token.admin == true || request.auth.token.email == 'pawme@ayvalabs.com');
    }

    // Rules for the 'users' collection
    match /users/{userId} {

      // Any authenticated user can read public user data for leaderboards and referrals.
      // Admin can read all user data.
      allow read: if request.auth != null;

      // New users can create their own user document upon signup.
      // The document ID must match the user's UID.
      allow create: if request.auth != null && request.auth.uid == userId;

      // Server-side AI usage counters. Owner can read (for the in-app
      // "X of Y left" hint). Only the Admin SDK (server) writes.
      match /usage/{periodId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false; // server-only via firebase-admin
      }

      // Users can update their own document or referral updates
      // Admin can update any user document
      allow update: if
        // Admin has full update access
        isAdmin() ||
        
        // Allow a user to update their own document (theme, profile, etc.)
        (request.auth != null && request.auth.uid == userId) ||

        // Allow a new signup to credit their referrer.
        // This is scoped to only allow incrementing points and referral count by the correct amounts.
        (
          request.auth != null &&
          request.resource.data.diff(resource.data).affectedKeys().hasAll(['points', 'referralCount']) &&
          request.resource.data.diff(resource.data).affectedKeys().size() == 2 &&
          request.resource.data.referralCount == resource.data.referralCount + 1 &&
          (
            request.resource.data.points == resource.data.points + 100 ||
            request.resource.data.points == resource.data.points + 150
          )
        );
    }

    // =====================================================
    // PawMe mobile — referral codes
    // =====================================================
    match /referralCodes/{code} {
      // Anyone authenticated can read (to validate codes when redeeming).
      allow read: if request.auth != null;
      // Only the owning user can claim a code (creates a doc with their uid).
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      // Codes are immutable once created.
      allow update, delete: if false;
    }

    // =====================================================
    // PawMe mobile — pet documents and subcollections
    // =====================================================
    function isPetOwner(petId) {
      return request.auth != null &&
        get(/databases/$(database)/documents/pets/$(petId)).data.userId == request.auth.uid;
    }

    match /pets/{petId} {
      // Owners can read/write their own pet document.
      allow read: if request.auth != null &&
        resource.data.userId == request.auth.uid;

      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;

      allow update, delete: if request.auth != null &&
        resource.data.userId == request.auth.uid;

      // Subcollections: vaccinations, medications, symptomChecks.
      // Owner of the parent pet has full access; admins can read.
      match /vaccinations/{recId} {
        allow read, write: if isAdmin() || isPetOwner(petId);
      }
      match /medications/{recId} {
        allow read, write: if isAdmin() || isPetOwner(petId);
      }
      match /symptomChecks/{recId} {
        allow read, write: if isAdmin() || isPetOwner(petId);
      }
      match /photoScans/{recId} {
        allow read, write: if isAdmin() || isPetOwner(petId);
      }
      match /trainingSessions/{recId} {
        allow read, write: if isAdmin() || isPetOwner(petId);
      }
      match /trackerImports/{recId} {
        allow read, write: if isAdmin() || isPetOwner(petId);
      }
    }

    // Rules for the 'verifications' collection
    match /verifications/{docId} {
      // Allow anyone to create a verification document with proper structure
      // This is needed for email verification during signup (before user is authenticated)
      allow create: if request.resource.data.keys().hasAll(['email', 'code', 'expiresAt']) &&
                      request.resource.data.size() == 3 &&
                      request.resource.data.email is string &&
                      request.resource.data.code is string &&
                      request.resource.data.expiresAt is timestamp;

      // Allow anyone to read verification codes (needed to verify the code during signup)
      // Security: codes are short-lived
      allow read: if true;

      // Allow anyone to delete verification codes (cleanup after successful verification)
      allow delete: if true;
      
      // No updates allowed - codes should be created and deleted, not modified
      allow update: if false;
    }

    // Rules for the 'emailTemplates' collection
    match /emailTemplates/{templateId} {
      // Only admin can read email templates
      allow read: if isAdmin();
      
      // Only admin can create, update, or delete email templates
      allow write: if isAdmin();
    }

    // Rules for the 'app-settings' collection
    match /app-settings/{settingId} {
      // Anyone can read app settings (for public display of referral tiers, rewards, etc.)
      allow read: if true;
      
      // Only admin can create, update, or delete app settings
      allow write: if isAdmin();
    }

    // Rules for pawme_virtuals tweet calendar — internal admin dashboard
    match /pawme_virtuals_tweets/{docId} {
      allow read, write: if true;
    }

    // =====================================================
    // PawMe Social Calendar — Internal Admin Dashboard
    // All collections below are admin-only (pawme@ayvalabs.com)
    // =====================================================

    // Drafts collection — social media draft posts
    match /drafts/{draftId} {
      allow read, write: if isAdmin();
    }

    // Scheduled posts — shared with pawme_website tweet calendar
    match /scheduled-posts/{postId} {
      allow read, write: if isAdmin();
    }

    // Scanned tweets — Twitter keyword scan results
    match /scanned_tweets/{tweetId} {
      allow read, write: if isAdmin();
    }

    // Published posts — posts that have been published to X
    match /published_posts/{postId} {
      allow read, write: if isAdmin();
    }

    // Content collection — content inbox items
    match /content/{contentId} {
      allow read, write: if isAdmin();
    }

    // Media assets — uploaded media files metadata
    match /media_assets/{assetId} {
      allow read, write: if isAdmin();
    }

    // Audit logs — action history for compliance
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if request.auth != null;
    }

    // Scan keywords — Twitter keyword configuration
    match /scan_keywords/{keywordId} {
      allow read, write: if isAdmin();
    }
  }
}
