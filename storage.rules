rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
             (request.auth.token.admin == true || 
              request.auth.token.email == 'pawme@ayvalabs.com');
    }

    // Helper function to check if user is shop admin
    function isShopAdmin() {
      return request.auth != null && 
             request.auth.token.email == 'pawme+admin@ayvalabs.com';
    }

    // Public read access for reward images
    match /rewards/{allPaths=**} {
      allow read;
      // Allow write only for admin users
      allow write: if isAdmin();
    }

    // Product images - public read, shop admin write
    match /products/{allPaths=**} {
      allow read: if true; // Anyone can read product images
      allow write: if isShopAdmin(); // Only shop admin can upload product images
    }
  }
}
